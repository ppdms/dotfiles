font-family = "JetBrainsMono Nerd Font Mono"
font-size = 15
shell-integration = none
command = /run/current-system/sw/bin/fish
term = xterm-256color

# Permit remote programs to write through OSC 52 (for example, copying from
# a shell on the Linux host into the macOS clipboard). Keep reads prompted:
# an OSC 52 read exposes the macOS clipboard to the remote host.
clipboard-write = allow
clipboard-read = ask

background = #1d2021
foreground = #ebdbb2
selection-foreground = #928374
selection-background = #ebdbb2
cursor-color = #928374
cursor-text = cell-background
cursor-style = underline

palette = 0=#665c54
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#7c6f64
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#bdae93

window-save-state = never
window-padding-x = 0
window-padding-y = 0
window-width = 84
window-height = 38
confirm-close-surface = false
macos-titlebar-style = tabs
macos-icon = glass
gtk-tabs-location = top

window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

keybind = super+digit_1=goto_tab:1
keybind = super+1=goto_tab:1
keybind = super+digit_2=goto_tab:2
keybind = super+2=goto_tab:2
keybind = super+digit_3=goto_tab:3
keybind = super+3=goto_tab:3
keybind = super+digit_4=goto_tab:4
keybind = super+4=goto_tab:4
keybind = super+digit_5=goto_tab:5
keybind = super+5=goto_tab:5
keybind = super+digit_6=goto_tab:6
keybind = super+6=goto_tab:6
keybind = super+digit_7=goto_tab:7
keybind = super+7=goto_tab:7
keybind = super+digit_8=goto_tab:8
keybind = super+8=goto_tab:8
keybind = super+digit_9=goto_tab:9
keybind = super+9=goto_tab:9
keybind = ctrl+t=new_tab
keybind = super+t=new_tab
keybind = ctrl+alt+enter=new_split:right
