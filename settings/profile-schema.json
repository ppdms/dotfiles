{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.invalid/profile-schema.json",
  "title": "Narrow non-secret machine profiles",
  "type": "object",
  "properties": {
    "profiles": {
      "type": "object",
      "properties": {
        "darwin": {
          "$ref": "#/$defs/darwin"
        },
        "nixos": {
          "$ref": "#/$defs/nixos"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "profiles"
  ],
  "additionalProperties": false,
  "$defs": {
    "darwin": {
      "type": "object",
      "properties": {
        "system": {
          "type": "object",
          "properties": {
            "hostname": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?$"
            },
            "username": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[a-z_][a-z0-9_-]*$"
            },
            "homeDirectory": {
              "$ref": "#/$defs/absolutePath"
            },
            "platform": {
              "type": "string",
              "enum": [
                "aarch64-darwin"
              ]
            },
            "role": {
              "type": "string",
              "enum": [
                "laptop"
              ]
            },
            "homeStateVersion": {
              "$ref": "#/$defs/homeStateVersion"
            },
            "systemStateVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "checkout": {
              "$ref": "#/$defs/absolutePath"
            }
          },
          "required": [
            "hostname",
            "username",
            "homeDirectory",
            "platform",
            "role",
            "homeStateVersion",
            "systemStateVersion",
            "checkout"
          ],
          "additionalProperties": false
        },
        "user": {
          "type": "object",
          "properties": {
            "fullName": {
              "$ref": "#/$defs/text"
            },
            "email": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^ @\r\n]+@[^ @\r\n]+$"
            },
            "templateEmail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^ @\r\n]+@[^ @\r\n]+$",
              "x-default-from": "email"
            },
            "gitSigningKey": {
              "type": [
                "null",
                "string"
              ],
              "pattern": "^((/|~/|[.]/)[^\r\n]+|(ssh-(ed25519|rsa)|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( [^\r\n]*)?)$",
              "maxLength": 8192,
              "default": null
            },
            "signCommits": {
              "type": "boolean",
              "default": true
            },
            "authorizedKeys": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/publicKey"
              },
              "maxItems": 256,
              "default": []
            }
          },
          "required": [
            "fullName",
            "email"
          ],
          "additionalProperties": false
        },
        "development": {
          "type": "object",
          "properties": {
            "nodeMajor": {
              "type": "integer",
              "minimum": 18,
              "maximum": 99
            },
            "pythonMinor": {
              "type": "integer",
              "minimum": 10,
              "maximum": 99
            }
          },
          "required": [
            "nodeMajor",
            "pythonMinor"
          ],
          "additionalProperties": false
        },
        "applications": {
          "type": "object",
          "properties": {
            "omp": {
              "type": "object",
              "properties": {
                "symbolPreset": {
                  "$ref": "#/$defs/name"
                },
                "theme": {
                  "type": "object",
                  "properties": {
                    "dark": {
                      "$ref": "#/$defs/name"
                    },
                    "light": {
                      "$ref": "#/$defs/name"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "setupVersion": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "edit": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "apply_patch",
                        "replace"
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "composer": {
                  "type": "object",
                  "properties": {
                    "shape": {
                      "$ref": "#/$defs/name"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "dev": {
                  "type": "object",
                  "properties": {
                    "autoqaConsent": {
                      "type": "string",
                      "enum": [
                        "granted",
                        "denied"
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "git": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "display": {
                  "type": "object",
                  "properties": {
                    "showTokenUsage": {
                      "type": "boolean"
                    },
                    "cacheMissMarker": {
                      "type": "boolean"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "statusLine": {
                  "type": "object",
                  "properties": {
                    "preset": {
                      "$ref": "#/$defs/name"
                    },
                    "separator": {
                      "$ref": "#/$defs/name"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "extendedContext": {
                  "type": "boolean"
                },
                "modelRoles": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/$defs/name"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/text"
                  }
                },
                "retry": {
                  "type": "object",
                  "properties": {
                    "fallbackChains": {
                      "type": "object",
                      "propertyNames": {
                        "$ref": "#/$defs/name"
                      },
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/text"
                        },
                        "maxItems": 256
                      }
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "codex": {
              "type": "object",
              "properties": {
                "sandboxMode": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "read-only",
                    "workspace-write",
                    "danger-full-access",
                    null
                  ],
                  "default": null
                }
              },
              "required": [],
              "additionalProperties": false,
              "default": {}
            },
            "zed": {
              "type": "object",
              "properties": {
                "sshConnections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "host": {
                        "$ref": "#/$defs/domain"
                      },
                      "username": {
                        "$ref": "#/$defs/text"
                      },
                      "args": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/text"
                        },
                        "maxItems": 256,
                        "default": []
                      },
                      "projects": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "paths": {
                              "type": "array",
                              "items": {
                                "$ref": "#/$defs/absolutePath"
                              },
                              "minItems": 1,
                              "maxItems": 256
                            }
                          },
                          "required": [
                            "paths"
                          ],
                          "additionalProperties": false
                        },
                        "maxItems": 256,
                        "default": []
                      }
                    },
                    "required": [
                      "host",
                      "username"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 256,
                  "default": []
                }
              },
              "required": [],
              "additionalProperties": false,
              "default": {}
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "ssh": {
          "type": "object",
          "properties": {
            "defaultKey": {
              "$ref": "#/$defs/name"
            },
            "defaultIdentityAgent": {
              "type": "string",
              "pattern": "^[^\r\n]*$",
              "maxLength": 1024,
              "default": ""
            },
            "clipboardHosts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              },
              "maxItems": 256,
              "default": []
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "secretName": {
                    "$ref": "#/$defs/name"
                  },
                  "keyFingerprint": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^SHA256:[A-Za-z0-9+/]+={0,3}$"
                  },
                  "keyComment": {
                    "$ref": "#/$defs/text"
                  },
                  "requireConfirm": {
                    "type": "boolean",
                    "default": true
                  },
                  "hostPatterns": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/text"
                    },
                    "maxItems": 256
                  },
                  "settings": {
                    "type": "object",
                    "propertyNames": {
                      "$ref": "#/$defs/text"
                    },
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "HostName": {
                          "$ref": "#/$defs/text"
                        },
                        "User": {
                          "$ref": "#/$defs/text"
                        },
                        "IdentityFile": {
                          "$ref": "#/$defs/text"
                        },
                        "IdentityAgent": {
                          "$ref": "#/$defs/text"
                        },
                        "ProxyCommand": {
                          "$ref": "#/$defs/text"
                        },
                        "ProxyJump": {
                          "$ref": "#/$defs/text"
                        },
                        "HostKeyAlias": {
                          "$ref": "#/$defs/text"
                        },
                        "UserKnownHostsFile": {
                          "$ref": "#/$defs/text"
                        },
                        "LocalForward": {
                          "$ref": "#/$defs/text"
                        },
                        "RemoteForward": {
                          "$ref": "#/$defs/text"
                        },
                        "DynamicForward": {
                          "$ref": "#/$defs/text"
                        },
                        "SetEnv": {
                          "$ref": "#/$defs/text"
                        },
                        "SendEnv": {
                          "$ref": "#/$defs/text"
                        },
                        "ControlPath": {
                          "$ref": "#/$defs/text"
                        },
                        "ControlMaster": {
                          "$ref": "#/$defs/text"
                        },
                        "ControlPersist": {
                          "$ref": "#/$defs/text"
                        },
                        "PreferredAuthentications": {
                          "$ref": "#/$defs/text"
                        },
                        "PubkeyAcceptedAlgorithms": {
                          "$ref": "#/$defs/text"
                        },
                        "HostKeyAlgorithms": {
                          "$ref": "#/$defs/text"
                        },
                        "Ciphers": {
                          "$ref": "#/$defs/text"
                        },
                        "MACs": {
                          "$ref": "#/$defs/text"
                        },
                        "KexAlgorithms": {
                          "$ref": "#/$defs/text"
                        },
                        "StrictHostKeyChecking": {
                          "$ref": "#/$defs/text"
                        },
                        "RequestTTY": {
                          "$ref": "#/$defs/text"
                        },
                        "RemoteCommand": {
                          "$ref": "#/$defs/text"
                        },
                        "LogLevel": {
                          "$ref": "#/$defs/text"
                        },
                        "IdentitiesOnly": {
                          "type": [
                            "boolean",
                            "string"
                          ],
                          "pattern": "^[^\r\n]*$",
                          "maxLength": 1024
                        },
                        "ForwardAgent": {
                          "type": [
                            "boolean",
                            "string"
                          ],
                          "pattern": "^[^\r\n]*$",
                          "maxLength": 1024
                        },
                        "AddKeysToAgent": {
                          "type": [
                            "boolean",
                            "string"
                          ],
                          "pattern": "^[^\r\n]*$",
                          "maxLength": 1024
                        },
                        "Compression": {
                          "type": [
                            "boolean",
                            "string"
                          ],
                          "pattern": "^[^\r\n]*$",
                          "maxLength": 1024
                        },
                        "TCPKeepAlive": {
                          "type": [
                            "boolean",
                            "string"
                          ],
                          "pattern": "^[^\r\n]*$",
                          "maxLength": 1024
                        },
                        "ExitOnForwardFailure": {
                          "type": [
                            "boolean",
                            "string"
                          ],
                          "pattern": "^[^\r\n]*$",
                          "maxLength": 1024
                        },
                        "Port": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65535
                        },
                        "ServerAliveInterval": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65535
                        },
                        "ServerAliveCountMax": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65535
                        },
                        "ConnectTimeout": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65535
                        }
                      },
                      "required": [],
                      "additionalProperties": false,
                      "propertyNames": {
                        "$ref": "#/$defs/name"
                      }
                    }
                  }
                },
                "required": [
                  "secretName",
                  "hostPatterns",
                  "settings"
                ],
                "additionalProperties": false,
                "anyOf": [
                  {
                    "required": [
                      "keyFingerprint"
                    ]
                  },
                  {
                    "required": [
                      "keyComment"
                    ]
                  }
                ]
              },
              "maxItems": 256
            }
          },
          "required": [
            "defaultKey",
            "keys"
          ],
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "properties": {
            "modes": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/name"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "proxyPacUrl": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^https?://[^ @\r\n]+$"
                  },
                  "dnsServers": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/ipAddress"
                    },
                    "maxItems": 256
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            }
          },
          "required": [],
          "additionalProperties": false,
          "default": {}
        }
      },
      "required": [
        "system",
        "user",
        "development",
        "ssh",
        "applications"
      ],
      "additionalProperties": false
    },
    "nixos": {
      "type": "object",
      "properties": {
        "system": {
          "type": "object",
          "properties": {
            "uid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "subUidRanges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startUid": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  }
                },
                "required": [ "startUid", "count" ],
                "additionalProperties": false
              },
              "maxItems": 256
            },
            "subGidRanges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startGid": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  }
                },
                "required": [ "startGid", "count" ],
                "additionalProperties": false
              },
              "maxItems": 256
            },
            "hostname": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?$"
            },
            "username": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[a-z_][a-z0-9_-]*$"
            },
            "homeDirectory": {
              "$ref": "#/$defs/absolutePath"
            },
            "platform": {
              "type": "string",
              "enum": [
                "x86_64-linux"
              ]
            },
            "role": {
              "type": "string",
              "enum": [
                "server"
              ]
            },
            "homeStateVersion": {
              "$ref": "#/$defs/homeStateVersion"
            },
            "systemStateVersion": {
              "$ref": "#/$defs/homeStateVersion"
            },
            "checkout": {
              "$ref": "#/$defs/absolutePath"
            }
          },
          "required": [
            "hostname",
            "username",
            "homeDirectory",
            "platform",
            "role",
            "homeStateVersion",
            "systemStateVersion",
            "checkout",
            "uid",
            "subUidRanges",
            "subGidRanges"
          ],
          "additionalProperties": false
        },
        "user": {
          "type": "object",
          "properties": {
            "fullName": {
              "$ref": "#/$defs/text"
            },
            "email": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^ @\r\n]+@[^ @\r\n]+$"
            },
            "templateEmail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^ @\r\n]+@[^ @\r\n]+$",
              "x-default-from": "email"
            },
            "gitSigningKey": {
              "type": [
                "null",
                "string"
              ],
              "pattern": "^((/|~/|[.]/)[^\r\n]+|(ssh-(ed25519|rsa)|ecdsa-sha2-nistp(256|384|521)) [A-Za-z0-9+/]+={0,3}( [^\r\n]*)?)$",
              "maxLength": 8192,
              "default": null
            },
            "signCommits": {
              "type": "boolean",
              "default": false
            },
            "authorizedKeys": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/publicKey"
              },
              "maxItems": 256,
              "default": []
            }
          },
          "required": [
            "fullName",
            "email"
          ],
          "additionalProperties": false
        },
        "development": {
          "type": "object",
          "properties": {
            "nodeMajor": {
              "type": "integer",
              "minimum": 18,
              "maximum": 99
            },
            "pythonMinor": {
              "type": "integer",
              "minimum": 10,
              "maximum": 99
            }
          },
          "required": [
            "nodeMajor",
            "pythonMinor"
          ],
          "additionalProperties": false
        },
        "applications": {
          "type": "object",
          "properties": {
            "omp": {
              "type": "object",
              "properties": {
                "symbolPreset": {
                  "$ref": "#/$defs/name"
                },
                "theme": {
                  "type": "object",
                  "properties": {
                    "dark": {
                      "$ref": "#/$defs/name"
                    },
                    "light": {
                      "$ref": "#/$defs/name"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "setupVersion": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "edit": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "apply_patch",
                        "replace"
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "composer": {
                  "type": "object",
                  "properties": {
                    "shape": {
                      "$ref": "#/$defs/name"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "dev": {
                  "type": "object",
                  "properties": {
                    "autoqaConsent": {
                      "type": "string",
                      "enum": [
                        "granted",
                        "denied"
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "git": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "display": {
                  "type": "object",
                  "properties": {
                    "showTokenUsage": {
                      "type": "boolean"
                    },
                    "cacheMissMarker": {
                      "type": "boolean"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "statusLine": {
                  "type": "object",
                  "properties": {
                    "preset": {
                      "$ref": "#/$defs/name"
                    },
                    "separator": {
                      "$ref": "#/$defs/name"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "extendedContext": {
                  "type": "boolean"
                },
                "modelRoles": {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/$defs/name"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/text"
                  }
                },
                "retry": {
                  "type": "object",
                  "properties": {
                    "fallbackChains": {
                      "type": "object",
                      "propertyNames": {
                        "$ref": "#/$defs/name"
                      },
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/text"
                        },
                        "maxItems": 256
                      }
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false,
          "default": {}
        },
        "hardware": {
          "type": "object",
          "properties": {
            "cpuVendor": {
              "type": "string",
              "enum": [ "intel", "amd", "other" ]
            },
            "raidEnabled": {
              "type": "boolean"
            },
            "smartDevices": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/absolutePath"
              },
              "maxItems": 256
            },
            "initrdAvailableKernelModules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/name"
              },
              "maxItems": 256
            },
            "initrdKernelModules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/name"
              },
              "maxItems": 256
            },
            "kernelModules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/name"
              },
              "maxItems": 256
            },
            "fileSystems": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/absolutePath"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "device": {
                    "$ref": "#/$defs/absolutePath"
                  },
                  "fsType": {
                    "$ref": "#/$defs/name"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/text"
                    },
                    "maxItems": 256,
                    "default": []
                  },
                  "neededForBoot": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "required": [
                  "device",
                  "fsType"
                ],
                "additionalProperties": false
              }
