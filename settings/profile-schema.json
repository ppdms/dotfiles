    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?$"
    },
    "publicKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
