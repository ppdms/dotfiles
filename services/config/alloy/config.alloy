// Alloy journal shipper: homelab journald -> Grafana Cloud Loki.
//
// One loki.source.journal reads the local journal; static relabel rules
// attach the homelab stack to every managed line:
//
// - container stdout/stderr: _SYSTEMD_USER_UNIT (user scope, pure app output)
// - native service output:   _SYSTEMD_UNIT (system scope)
// - start/stop lifecycle:    UNIT (_SYSTEMD_UNIT is init.scope there)
//
// Non-homelab journal noise is dropped, secrets are redacted, and only the
// queryable label set ships to Grafana Cloud.
//
// Credentials arrive as environment from the Quadlet EnvironmentFile
// assembled from the scoped broker's runtime credential fields; never committed here.

logging {
	level  = "info"
	format = "logfmt"
}

loki.relabel "homelab" {
	forward_to = []
	rule {
		source_labels = ["__journal__systemd_user_unit"]
		regex         = "^alloy.service$"
		target_label  = "stack"
		replacement   = "alloy"
	}
	rule {
		source_labels = ["__journal__systemd_user_unit"]
		regex         = "^authelia.service$"
		target_label  = "stack"
		replacement   = "authelia"
	}
	rule {
		source_labels = ["__journal__systemd_user_unit"]
		regex         = "^backrest.service$"
		target_label  = "stack"
		replacement   = "backrest"
	}
	rule {
		source_labels = ["__journal__systemd_user_unit"]
		regex         = "^nginx.service$"
		target_label  = "stack"
		replacement   = "nginx-proxy"
	}
	rule {
		source_labels = ["__journal__systemd_user_unit"]
		regex         = "^opencloud.service$"
		target_label  = "stack"
		replacement   = "opencloud"
	}
	rule {
		source_labels = ["__journal__systemd_user_unit"]
