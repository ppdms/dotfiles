[Unit]
Description=Homelab LAN and tunnel ingress
PartOf=homelab.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
ContainerName=nginx-proxy
Image=@image:nginx@
Pull=never
User=101:101
UserNS=keep-id:uid=101,gid=101
Entrypoint=/bin/sh
Exec=/etc/nginx/ingress/start-nginx.sh
# Host networking reaches each application's loopback-only published endpoint.
# The system-owned LAN/canonical-OIDC forwards terminate on high loopback ports.
Network=host
# Preserve the host supplemental origin group without mapping it to a sub-GID.
GroupAdd=keep-groups
Volume=@nginx-config@:/etc/nginx/ingress:ro
Volume=@nginx-config@/nginx.conf:/etc/nginx/nginx.conf:ro
Volume=@nginx-state-directory@:/run/nginx-state:ro
Volume=%t/homelab-secrets/nginx:/run/secrets:ro
Volume=@origin-directory@:/run/cloudflared-origin:rw
Environment=TZ=UTC
NoNewPrivileges=true
DropCapability=all

[Service]
ExecStartPre=@secret-helper@ prepare nginx
ExecStartPre=@nginx-state-helper@
ExecStopPost=@secret-helper@ persist nginx
# No low port capability/sysctl in the host namespace. Unix origin is not an IP bind.
SocketBindAllow=tcp:@port-nginxHttp@
SocketBindAllow=tcp:@port-nginxHttps@
SocketBindDeny=any
Restart=on-failure
RestartSec=15s
TimeoutStartSec=180s
TimeoutStopSec=120s
UMask=0077
TasksMax=512
MemoryHigh=410M
MemoryMax=512M

[Install]
WantedBy=homelab.target
