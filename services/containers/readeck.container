[Unit]
Description=Readeck read-it-later service
PartOf=homelab.target
Requires=apps-net-network.service
After=apps-net-network.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
ContainerName=readeck
Image=@image:readeck@
User=1000:1000
UserNS=keep-id:uid=1000,gid=1000
Pull=never
Network=apps-net.network
PublishPort=127.0.0.1:@port-readeck@:8000
Volume=@state-root@/readeck/data:/readeck:rw
Environment=READECK_LOG_LEVEL=info
Environment=READECK_SERVER_HOST=0.0.0.0
Environment=READECK_SERVER_PORT=8000
Environment=READECK_LOG_FORMAT=text
NoNewPrivileges=true
DropCapability=all
HealthCmd=/bin/readeck healthcheck -config config.toml
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=60s

[Service]
ExecStartPre=@state-helper@
Restart=on-failure
RestartSec=15s
TimeoutStartSec=180s
TimeoutStopSec=120s
UMask=0077
TasksMax=512
MemoryHigh=819M
MemoryMax=1G

[Install]
WantedBy=homelab.target
