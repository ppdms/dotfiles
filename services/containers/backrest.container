[Unit]
Description=Backrest backup server
PartOf=homelab.target
Requires=apps-net-network.service
After=apps-net-network.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
ContainerName=backrest
HostName=backrest
Image=@image:backrest@
User=1000:1000
UserNS=keep-id:uid=1000,gid=1000
Pull=never
Network=apps-net.network
GroupAdd=keep-groups
PublishPort=127.0.0.1:@port-backrest@:9898
Entrypoint=/backrest
Volume=@state-root@/backrest/config:/config
Volume=@state-root@/backrest/data:/data
Volume=@state-root@/backrest/cache:/cache
Volume=@state-root@/backrest/tmp:/tmp
Volume=@restore-destination@:/restore
Volume=@immich-path@:/backup/raid-immich:ro
Volume=@opencloud-path@:/backup/raid-opencloud:ro
Volume=@backup-state-root@:/backup/nvme-homelab-state:ro
Volume=@config-checkout@:/backup/nvme-homelab-repo:ro
Volume=@backup-quadlets@:/backup/nvme-quadlet-manifests:ro
Volume=%t/homelab-secrets/backrest/restic:/run/secrets:ro
Volume=%t/homelab-secrets/backrest/rclone:/run/rclone
Environment=HOME=/data
Environment=BACKREST_CONFIG=/config/config.json
Environment=BACKREST_DATA=/data
Environment=BACKREST_PORT=0.0.0.0:9898
Environment=BACKREST_RESTIC_COMMAND=/bin/restic
Environment=XDG_CACHE_HOME=/cache
Environment=TMPDIR=/tmp
Environment=RESTIC_PASSWORD_FILE=/run/secrets/restic-password
Environment=RCLONE_CONFIG=/run/rclone/rclone.conf
Environment=TZ=@timezone@
NoNewPrivileges=true
DropCapability=all
Notify=healthy
HealthCmd=wget -q --spider http://127.0.0.1:9898/
HealthInterval=5s
HealthTimeout=3s
HealthRetries=6
HealthStartPeriod=5s

[Service]
Restart=on-failure
RestartSec=15s
TimeoutStartSec=180s
TimeoutStopSec=120s
TasksMax=1024
MemoryHigh=1638M
MemoryMax=2G
UMask=0077

[Install]
WantedBy=homelab.target
