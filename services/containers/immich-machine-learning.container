[Unit]
Description=Immich CPU machine learning
PartOf=homelab.target
Requires=apps-net-network.service
After=apps-net-network.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
ContainerName=immich_machine_learning
Image=@image:immich-machine-learning@
User=1000:1000
UserNS=keep-id:uid=1000,gid=1000
Pull=never
Network=apps-net.network
NetworkAlias=immich-ml
NetworkAlias=immich-machine-learning
Volume=immich_model-cache:/cache:rw
Environment=MACHINE_LEARNING_REQUEST_THREADS=1
Environment=MACHINE_LEARNING_MODEL_INTRA_OP_THREADS=1
Environment=MACHINE_LEARNING_WORKER_TIMEOUT=900
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=15s
TimeoutStartSec=180s
TimeoutStopSec=120s
UMask=0077
TasksMax=1024
MemoryHigh=3277M
MemoryMax=4G

[Install]
WantedBy=homelab.target
