#!/usr/bin/env bash
# originally copied from:
# https://codeberg.org/EvanHahn/dotfiles/src/commit/843b9ee13d949d346a4a73ccee2a99351aed285b/home/bin/bin
set -e
set -u
set -o pipefail

if [[ $# -ne 1 ]]; then
  echo 'must pass exactly 1 argument' 1>&2
  exit 1
fi

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
path="$XDG_CONFIG_HOME/evanhahn-snippets/$1"

die() {
  echo "no snippet found at $path" 1>&2
  exit 1
}

cat "$path" 2>/dev/null || die
