#!/usr/bin/env bash
# originally copied from:
# https://codeberg.org/EvanHahn/dotfiles/src/commit/843b9ee13d949d346a4a73ccee2a99351aed285b/home/bin/bin
set -e
set -u
set -o pipefail

if hash rink 2>/dev/null; then
	exec rink
elif hash python3 2>/dev/null; then
	exec python3 -i -c 'from math import *; from statistics import *'
elif hash bc 2>/dev/null; then
	exec bc
else
	>&2 echo "couldn't find any math program"
	exit 1
fi
