#!/usr/bin/env bash
# originally copied from:
# https://codeberg.org/EvanHahn/dotfiles/src/commit/843b9ee13d949d346a4a73ccee2a99351aed285b/home/bin/bin
set -e
set -u
set -o pipefail

BROWSER="${BROWSER:-open}"

if [ $# -eq 0 ]; then
  "$BROWSER" 'https://duckduckgo.com'
else
  args="$*"
  search="${args// /+}"
  "$BROWSER" "https://duckduckgo.com/?q=$search"
fi
